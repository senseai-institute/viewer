# senseai-viewer configuration. Every variable is optional: with none set, the server
# builds the synthetic demo run and serves it read-only.

# Where RunLog files live (DATA_DIR/runs/*.h5). Mount a Railway volume here to keep
# uploaded runs across deploys; without one, runs live in the container and the demo run
# is rebuilt on each start. If the directory is not writable the server falls back to a
# temporary directory and logs a warning.
DATA_DIR=/data

# Build the synthetic Panther-vs-default run when DATA_DIR has no runs (1 = yes).
DEMO_RUN=1

# Bearer token that enables PUT /api/runs (upload) and DELETE /api/runs/{id}.
# Unset = uploads disabled (the safe default for a public demo).
UPLOAD_TOKEN=

# Largest upload accepted, in MB.
MAX_UPLOAD_MB=200

# Base URL used in the share links returned by uploads, e.g. https://viewer.up.railway.app
PUBLIC_BASE_URL=

# In-memory window cache budget, in MB.
WINDOW_CACHE_MB=64

# Railway sets PORT itself.
# PORT=8000

# ---- Live POC on the box with the data (EC2) -------------------------------------------
# Password for the whole site (HTTP Basic; any username). Required to use the runner from
# anywhere but this machine itself. Health checks stay open.
VIEWER_PASSWORD=

# Turn on the Run page: it starts senseai-bench processes. Off by default.
SENSEAI_RUNNER=0
# Folder holding the DSEC sequences (searched three levels deep for images/left/rectified).
SENSEAI_DATA_ROOT=
# Enable the contestants that need the trained world model (both must exist).
SENSEAI_WORLD_CKPT=
SENSEAI_TOKENS_YAML=
# Optional senseai.yaml passed to bench as --sdk-config.
SENSEAI_SDK_CONFIG=
# How to call bench, and its interpreter (used to check torchvision / ultralytics).
SENSEAI_BENCH_CMD=senseai-bench
SENSEAI_BENCH_PYTHON=
