# senseai-viewer configuration. Every variable is optional: with none set, the server
# builds the synthetic demo run and serves it read-only.

# Where RunLog files live (DATA_DIR/runs/*.h5). Mount a Railway volume here to keep
# uploaded runs across deploys; without one, runs live in the container and the demo run
# is rebuilt on each start. If the directory is not writable the server falls back to a
# temporary directory and logs a warning.
DATA_DIR=/data

# Build the synthetic Panther-vs-default run when DATA_DIR has no runs (1 = yes).
DEMO_RUN=1

# Bearer token that enables PUT /api/runs (upload) and DELETE /api/runs/{id}.
# Unset = uploads disabled (the safe default for a public demo).
UPLOAD_TOKEN=

# Largest upload accepted, in MB.
MAX_UPLOAD_MB=200

# Base URL used in the share links returned by uploads, e.g. https://viewer.up.railway.app
PUBLIC_BASE_URL=

# In-memory window cache budget, in MB.
WINDOW_CACHE_MB=64

# Railway sets PORT itself.
# PORT=8000

# ---- Live POC on the box with the data (EC2) -------------------------------------------
# Password for the whole site (HTTP Basic; any username). Required to use the runner from
# anywhere but this machine itself. Health checks stay open.
VIEWER_PASSWORD=

# Turn on the Run page (/run): it downloads recordings and starts processes. Off by default.
SENSEAI_RUNNER=0
# Where recordings are prepared (default /data/dsec).
SENSEAI_DATA_ROOT=
# The recordings bucket and prefix (read through the instance role).
SENSEAI_S3_URI=s3://senseai-data/raw/dsec/
# Where the seven SenseAI repos and their shared .venv live (default ~/senseai).
SENSEAI_STACK_DIR=
# Optional: a tokens-format panther_vision profile to also tokenize with.
SENSEAI_PANTHER_TOKENS_PROFILE=
# Optional: the install / repair script (default deploy/setup_ec2.sh).
SENSEAI_SETUP_SCRIPT=
# Overrides, normally found in SENSEAI_STACK_DIR: the bench command, the stack's Python, the
# tokens config, and a ready-made senseai.yaml for runs that train nothing.
SENSEAI_BENCH_CMD=senseai-bench
SENSEAI_BENCH_PYTHON=
SENSEAI_TOKENS_YAML=
SENSEAI_SDK_CONFIG=

# ---- Real runs from bench, kept in S3 (senseai-viewer push) ------------------------------
# Where runs live; the server lists their viewer.json manifests and fetches a RunLog when it
# is first opened. Unset = runs only from DATA_DIR.
SENSEAI_RUNS_S3=
# Disk kept for opened runs, in GB (least recently opened are evicted).
SENSEAI_CACHE_GB=2
# Read-only IAM user for SENSEAI_RUNS_S3 (s3:ListBucket on the prefix, s3:GetObject).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
# Largest tarball accepted by POST /api/runs/import, in MB.
MAX_IMPORT_MB=4096
